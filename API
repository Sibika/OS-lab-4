using System;
using System.Collections.Concurrent;
using System.Collections.Generic;
using System.Linq;
using System.Threading;

namespace MyLab4
{
    public class WorkerInfo
    {
        public int Id { get; set; }
        public string Name { get; set; }
        public WorkerState State { get; set; }
        public ThreadPriority Priority { get; set; }
        public int CurrentCounter { get; set; }
        public int SpeedMs { get; set; }
        public DateTime CreatedAt { get; set; }
        public DateTime? StartedAt { get; set; }
        public Dictionary<string, object> CustomData { get; set; }
        public bool IsAlive { get; set; }
        public int? ClonedFrom { get; set; }
    }

    public class DataExchangeRecord
    {
        public DateTime Timestamp { get; set; }
        public int WorkerId { get; set; }
        public string Direction { get; set; }
        public string DataType { get; set; }
        public string Data { get; set; }
    }

    public class WorkerManager
    {
        private readonly ConcurrentDictionary<int, WorkerThread> workers;
        private int nextWorkerId = 1;
        private readonly object lockObj = new object();
        private readonly List<DataExchangeRecord> dataExchangeHistory;
        private readonly int maxHistorySize = 500;

        public event Action<int, WorkerState> OnWorkerStateChanged;
        public event Action<int, int> OnWorkerCounterChanged;
        public event Action<int, DataMessage> OnDataReceived;
        public event Action<int, DataMessage> OnDataSent;
        public event Action<int, ThreadPriority> OnWorkerPriorityChanged;

        public WorkerManager()
        {
            workers = new ConcurrentDictionary<int, WorkerThread>();
            dataExchangeHistory = new List<DataExchangeRecord>();
        }

        public int CreateWorker(int speed = 50)
        {
            int workerId;
            lock (lockObj)
            {
                workerId = nextWorkerId++;
            }

            var worker = new WorkerThread(workerId, speed);

            worker.OnStateChanged += (id, state) => OnWorkerStateChanged?.Invoke(id, state);
            worker.OnCounterChanged += (id, counter) => OnWorkerCounterChanged?.Invoke(id, counter);
            worker.OnPriorityChanged += (id, priority) => OnWorkerPriorityChanged?.Invoke(id, priority);
            worker.OnDataReceived += (id, msg) =>
            {
                OnDataReceived?.Invoke(id, msg);
                AddToHistory(id, "Родитель → Дочерний", msg.DataType, msg.Content);
            };
            worker.OnDataSent += (id, msg) =>
            {
                OnDataSent?.Invoke(id, msg);
                AddToHistory(id, "Дочерний → Родитель", msg.DataType, msg.Content);
            };

            if (workers.TryAdd(workerId, worker))
            {
                worker.Start();
                return workerId;
            }

            return -1;
        }

        public bool StopWorker(int workerId)
        {
            if (workers.TryGetValue(workerId, out var worker))
            {
                worker.Stop();
                return true;
            }
            return false;
        }

        public bool PauseWorker(int workerId)
        {
            if (workers.TryGetValue(workerId, out var worker))
            {
                worker.Pause();
                return true;
            }
            return false;
        }

        public bool ResumeWorker(int workerId)
        {
            if (workers.TryGetValue(workerId, out var worker))
            {
                worker.Resume();
                return true;
            }
            return false;
        }

        public bool SetWorkerPriority(int workerId, ThreadPriority priority)
        {
            if (workers.TryGetValue(workerId, out var worker) && worker.IsAlive)
            {
                worker.Priority = priority;
                return true;
            }
            return false;
        }

        public bool SetWorkerSpeed(int workerId, int speedMs)
        {
            if (workers.TryGetValue(workerId, out var worker))
            {
                worker.UpdateSpeed(speedMs);
                return true;
            }
            return false;
        }

        public int CloneWorker(int sourceWorkerId)
        {
            if (workers.TryGetValue(sourceWorkerId, out var sourceWorker))
            {
                int newWorkerId;
                lock (lockObj)
                {
                    newWorkerId = nextWorkerId++;
                }

                var clonedWorker = sourceWorker.Clone(newWorkerId);

                clonedWorker.OnStateChanged += (id, state) => OnWorkerStateChanged?.Invoke(id, state);
                clonedWorker.OnCounterChanged += (id, counter) => OnWorkerCounterChanged?.Invoke(id, counter);
                clonedWorker.OnPriorityChanged += (id, priority) => OnWorkerPriorityChanged?.Invoke(id, priority);
                clonedWorker.OnDataReceived += (id, msg) =>
                {
                    OnDataReceived?.Invoke(id, msg);
                    AddToHistory(id, "Родитель → Дочерний", msg.DataType, msg.Content);
                };
                clonedWorker.OnDataSent += (id, msg) =>
                {
                    OnDataSent?.Invoke(id, msg);
                    AddToHistory(id, "Дочерний → Родитель", msg.DataType, msg.Content);
                };

                if (workers.TryAdd(newWorkerId, clonedWorker))
                {
                    clonedWorker.Start();
                    return newWorkerId;
                }
            }
            return -1;
        }

        public bool SendDataToWorker(int workerId, string dataType, string data)
        {
            if (workers.TryGetValue(workerId, out var worker) && worker.IsAlive)
            {
                worker.SendData(dataType, data);
                return true;
            }
            return false;
        }

        public DataMessage ReceiveDataFromWorker(int workerId)
        {
            if (workers.TryGetValue(workerId, out var worker))
            {
                return worker.ReceiveData();
            }
            return null;
        }

        public WorkerInfo GetWorkerInfo(int workerId)
        {
            if (workers.TryGetValue(workerId, out var worker))
            {
                return new WorkerInfo
                {
                    Id = workerId,
                    Name = worker.GetWorkerData("Name")?.ToString() ?? $"Worker-{workerId}",
                    State = worker.GetCurrentState(),
                    Priority = worker.Priority,
                    CurrentCounter = worker.GetCurrentCounter(),
                    SpeedMs = worker.GetSpeed(),
                    CreatedAt = worker.GetCreatedAt(),
                    StartedAt = worker.GetStartedAt(),
                    CustomData = worker.GetAllData(),
                    IsAlive = worker.IsAlive,
                    ClonedFrom = worker.GetClonedFrom()
                };
            }
            return null;
        }

        public List<WorkerInfo> GetAllWorkers()
        {
            return workers.Values
                .Where(w => w.IsAlive)
                .Select(w => GetWorkerInfo(w.WorkerId))
                .Where(info => info != null)
                .ToList();
        }

        public List<DataExchangeRecord> GetDataExchangeHistory(int workerId = 0)
        {
            lock (dataExchangeHistory)
            {
                if (workerId == 0)
                    return dataExchangeHistory.ToList();
                return dataExchangeHistory.Where(r => r.WorkerId == workerId).ToList();
            }
        }

        public bool IsWorkerAlive(int workerId)
        {
            return workers.TryGetValue(workerId, out var worker) && worker.IsAlive;
        }

        public void CleanupDeadWorkers()
        {
            var deadWorkers = workers.Where(w => !w.Value.IsAlive).Select(w => w.Key).ToList();
            foreach (var id in deadWorkers)
            {
                workers.TryRemove(id, out _);
            }
        }

        public void PauseAllWorkers()
        {
            foreach (var worker in workers.Values)
            {
                worker.Pause();
            }
        }

        public void ResumeAllWorkers()
        {
            foreach (var worker in workers.Values)
            {
                worker.Resume();
            }
        }

        public void StopAllWorkers()
        {
            foreach (var worker in workers.Values)
            {
                worker.Stop();
            }
        }

        public void SetGlobalSpeed(int speedMs)
        {
            foreach (var worker in workers.Values)
            {
                worker.UpdateSpeed(speedMs);
            }
        }

        public void SendDataToAllWorkers(string dataType, string data)
        {
            foreach (var worker in workers.Values)
            {
                if (worker.IsAlive)
                {
                    worker.SendData(dataType, data);
                }
            }
            AddToHistory(0, "Родитель → Все", dataType, data);
        }

        public int GetActiveWorkersCount()
        {
            return workers.Count(w => w.Value.IsAlive);
        }

        public void Shutdown()
        {
            StopAllWorkers();
            foreach (var worker in workers.Values)
            {
                worker.Join(1000);
            }
        }

        private void AddToHistory(int workerId, string direction, string dataType, string data)
        {
            lock (dataExchangeHistory)
            {
                dataExchangeHistory.Insert(0, new DataExchangeRecord
                {
                    Timestamp = DateTime.Now,
                    WorkerId = workerId,
                    Direction = direction,
                    DataType = dataType,
                    Data = data
                });

                while (dataExchangeHistory.Count > maxHistorySize)
                {
                    dataExchangeHistory.RemoveAt(dataExchangeHistory.Count - 1);
                }
            }
        }
    }
}
