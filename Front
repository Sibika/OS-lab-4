        private void OnWorkerStateChanged(int workerId, WorkerState state)
        {
            this.Invoke(new Action(() =>
            {
                var control = FindWorkerControl(workerId);
                if (control != null)
                {
                    control.UpdateState(state);
                }
            }));
        }

        private void OnWorkerCounterChanged(int workerId, int counter)
        {
            this.Invoke(new Action(() =>
            {
                var control = FindWorkerControl(workerId);
                if (control != null)
                {
                    control.UpdateCounter(counter);
                }
            }));
        }

        private void OnWorkerPriorityChanged(int workerId, ThreadPriority priority)
        {
            this.Invoke(new Action(() =>
            {
                var control = FindWorkerControl(workerId);
                if (control != null)
                {
                    control.UpdatePriorityFromEvent(priority);
                }
            }));
        }

        private void OnDataExchange(int workerId, DataMessage message)
        {
            this.Invoke(new Action(() =>
            {
                string direction = message.DataType == "Ответ" ? "Дочерний → Родитель" : "Родитель → Дочерний";
                dgvDataExchange.Rows.Insert(0,
                    DateTime.Now.ToString("HH:mm:ss"),
                    workerId,
                    direction,
                    message.DataType,
                    message.Content);

                while (dgvDataExchange.Rows.Count > 100)
                {
                    dgvDataExchange.Rows.RemoveAt(dgvDataExchange.Rows.Count - 1);
                }
            }));
        }

        private void UiTimer_Tick(object sender, EventArgs e)
        {
            workerManager.CleanupDeadWorkers();

            var existingControls = flowPanel.Controls.Cast<WorkerControl>().ToList();
            var currentWorkers = workerManager.GetAllWorkers();

            foreach (var control in existingControls)
            {
                if (!currentWorkers.Any(w => w.Id == control.WorkerId))
                {
                    flowPanel.Controls.Remove(control);
                    control.Dispose();
                }
            }

            foreach (var workerInfo in currentWorkers)
            {
                if (!existingControls.Any(c => c.WorkerId == workerInfo.Id))
                {
                    var control = new WorkerControl(workerInfo, workerManager);
                    flowPanel.Controls.Add(control);
                }
            }
            
            flowPanel.Height = flowPanel.Controls.Count * 105;
        }

        private WorkerControl FindWorkerControl(int workerId)
        {
            foreach (WorkerControl control in flowPanel.Controls)
            {
                if (control.WorkerId == workerId)
                    return control;
            }
            return null;
        }

        private void MainForm_FormClosing(object sender, FormClosingEventArgs e)
