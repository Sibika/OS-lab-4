        public void UpdateCounter(int counter)
        {
            if (this.InvokeRequired)
            {
                this.Invoke(new Action(() => UpdateCounter(counter)));
                return;
            }
            lblCounter.Text = counter.ToString();
            if (counter < 30)
                lblCounter.BackColor = Color.LightGreen;
            else if (counter < 70)
                lblCounter.BackColor = Color.LightYellow;
            else
                lblCounter.BackColor = Color.LightCoral;
        }

        public void UpdateState(WorkerState state)
        {
            if (this.InvokeRequired)
            {
                this.Invoke(new Action(() => UpdateState(state)));
                return;
            }

            switch (state)
            {
                case WorkerState.Running:
                    lblState.Text = "▶ Выполняется";
                    lblState.ForeColor = Color.Green;
                    btnPause.Enabled = true;
                    btnResume.Enabled = false;
                    btnStop.Enabled = true;
                    btnClone.Enabled = true;
                    this.BackColor = Color.White;
                    break;
                case WorkerState.Paused:
                    lblState.Text = "⏸ На паузе";
                    lblState.ForeColor = Color.Orange;
                    btnPause.Enabled = false;
                    btnResume.Enabled = true;
                    btnStop.Enabled = true;
                    btnClone.Enabled = true;
                    this.BackColor = Color.LightYellow;
                    break;
                case WorkerState.Stopping:
                    lblState.Text = "⏹ Остановка...";
                    lblState.ForeColor = Color.Red;
                    btnPause.Enabled = false;
                    btnResume.Enabled = false;
                    btnStop.Enabled = false;
                    btnClone.Enabled = false;
                    this.BackColor = Color.LightGray;
                    break;
                case WorkerState.Stopped:
                    lblState.Text = "⏹ Остановлен";
                    lblState.ForeColor = Color.DarkRed;
                    btnPause.Enabled = false;
                    btnResume.Enabled = false;
                    btnStop.Enabled = false;
                    btnClone.Enabled = false;
                    this.BackColor = Color.LightGray;
                    break;
            }
        }

        public void UpdatePriorityFromEvent(ThreadPriority priority)
        {
            if (this.InvokeRequired)
            {
                this.Invoke(new Action(() => UpdatePriorityFromEvent(priority)));
                return;
            }

            if (!isPriorityChanging)
            {
                isUpdatingFromCode = true;
                cbPriority.SelectedIndex = (int)priority;
                isUpdatingFromCode = false;
            }
        }

        private void UpdatePriorityDisplay()
        {
            if (this.InvokeRequired)
            {
                this.Invoke(new Action(UpdatePriorityDisplay));
                return;
            }

            try
            {
                var info = workerManager.GetWorkerInfo(workerInfo.Id);
                if (info != null && info.IsAlive)
                {
                    int currentPriority = (int)info.Priority;
                    if (cbPriority.SelectedIndex != currentPriority && !isPriorityChanging)
                    {
                        isUpdatingFromCode = true;
                        cbPriority.SelectedIndex = currentPriority;
                        isUpdatingFromCode = false;
                    }
                }
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"UpdatePriorityDisplay error: {ex.Message}");
            }
        }

        private void DisableControls()
        {
            if (this.InvokeRequired)
            {
                this.Invoke(new Action(DisableControls));
                return;
            }

            if (cbPriority != null) cbPriority.Enabled = false;
            if (btnPause != null) btnPause.Enabled = false;
            if (btnStop != null) btnStop.Enabled = false;
            if (btnResume != null) btnResume.Enabled = false;
            if (btnClone != null) btnClone.Enabled = false;
        }

        protected override void Dispose(bool disposing)
        {
            isDisposing = true;
            if (disposing)
            {
                updateTimer?.Stop();
                updateTimer?.Dispose();
            }
            base.Dispose(disposing);
        }
