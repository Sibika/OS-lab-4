        private bool isDisposing = false;
        private bool isPriorityChanging = false;

        public int WorkerId => workerInfo.Id;

        public WorkerControl(WorkerInfo info, WorkerManager manager)
        {
            workerInfo = info;
            workerManager = manager;
            InitializeComponent();
            UpdateState(workerInfo.State);
            UpdateCounter(workerInfo.CurrentCounter);

            cbPriority.SelectedIndexChanged += (s, e) =>
            {
                if (isUpdatingFromCode || isPriorityChanging) return;
                
                if (workerManager.IsWorkerAlive(workerInfo.Id) && cbPriority.SelectedIndex >= 0)
                {
                    isPriorityChanging = true;
                    workerManager.SetWorkerPriority(workerInfo.Id, (ThreadPriority)cbPriority.SelectedIndex);
                    isPriorityChanging = false;
                }
            };

            updateTimer = new System.Windows.Forms.Timer { Interval = 1000 };
            updateTimer.Tick += (s, e) =>
            {
                if (isDisposing) return;
                
                try
                {
                    if (this.IsHandleCreated && workerManager.IsWorkerAlive(workerInfo.Id))
                    {
                        if (!isPriorityChanging)
                        {
                            UpdatePriorityDisplay();
                        }
                    }
                    else if (!workerManager.IsWorkerAlive(workerInfo.Id))
                    {
                        DisableControls();
                        updateTimer.Stop();
                    }
                }
                catch (ObjectDisposedException)
                {
                    updateTimer.Stop();
                }
            };
            updateTimer.Start();
        }

